# Personalitify — environment configuration
# `npm run dev` creates a local .env from this file automatically and fills in
# freshly generated secrets. Never commit a real .env file.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- API server ------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000

# Origins allowed to call the API from a browser (comma separated).
WEB_ORIGINS=http://localhost:5173

# Public URL of the web application, used in links inside emails.
PUBLIC_WEB_URL=http://localhost:5173

# --- Database --------------------------------------------------------------
# A local MongoDB Community Server. Open the same URI in MongoDB Compass.
MONGODB_URI=mongodb://127.0.0.1:27017/personalitify

# --- Authentication --------------------------------------------------------
# At least 32 characters. Generated automatically for local development.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Set to true when the API is served over HTTPS.
COOKIE_SECURE=false

# --- Email (optional) ------------------------------------------------------
# Without SMTP settings, emails are written to the API log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Personalitify <no-reply@personalitify.local>
