{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/efecrtgl/Personalitify/blob/main/docs/api/schemas/entities/settings.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "UUID"
    },
    "version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Entity version, incremented on every change"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": ["tr", "en"]
    },
    "theme": {
      "type": "string",
      "enum": ["system", "light", "dark"]
    },
    "timeZone": {
      "type": "string"
    },
    "dateFormat": {
      "type": "string",
      "enum": ["dmy", "mdy", "ymd"]
    },
    "timeFormat": {
      "type": "string",
      "enum": ["24h", "12h"]
    },
    "weekStart": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 6
        },
        {
          "type": "number",
          "const": 7
        }
      ],
      "description": "ISO weekday the week starts on: 1 Monday, 6 Saturday, 7 Sunday"
    },
    "notifications": {
      "type": "object",
      "properties": {
        "inApp": {
          "type": "boolean"
        },
        "habitReminders": {
          "type": "boolean"
        },
        "taskReminders": {
          "type": "boolean"
        },
        "goalReminders": {
          "type": "boolean"
        },
        "eventReminders": {
          "type": "boolean"
        },
        "achievements": {
          "type": "boolean"
        },
        "quietHours": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "start": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "description": "Time of day, HH:mm (24-hour)"
            },
            "end": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "description": "Time of day, HH:mm (24-hour)"
            }
          },
          "required": ["enabled", "start", "end"],
          "additionalProperties": false
        }
      },
      "required": [
        "inApp",
        "habitReminders",
        "taskReminders",
        "goalReminders",
        "eventReminders",
        "achievements",
        "quietHours"
      ],
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "hideSensitivePreviews": {
          "type": "boolean",
          "description": "Hide journal and mood text in previews, summaries and notifications"
        }
      },
      "required": ["hideSensitivePreviews"],
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "properties": {
        "focusMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "shortBreakMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "longBreakMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "longBreakEvery": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "A long break follows every this many focus sessions"
        }
      },
      "required": ["focusMinutes", "shortBreakMinutes", "longBreakMinutes", "longBreakEvery"],
      "additionalProperties": false,
      "description": "Timer lengths in minutes"
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "widgets": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "progress",
                  "quickActions",
                  "habits",
                  "tasks",
                  "events",
                  "goals",
                  "week",
                  "streaks",
                  "insights",
                  "activity"
                ]
              },
              "visible": {
                "type": "boolean"
              }
            },
            "required": ["id", "visible"],
            "additionalProperties": false
          },
          "description": "Dashboard widgets in display order, each with its visibility"
        }
      },
      "required": ["widgets"],
      "additionalProperties": false,
      "description": "Layout of the personal dashboard"
    }
  },
  "required": [
    "id",
    "version",
    "createdAt",
    "updatedAt",
    "language",
    "theme",
    "timeZone",
    "dateFormat",
    "timeFormat",
    "weekStart",
    "notifications",
    "privacy",
    "focus",
    "dashboard"
  ],
  "additionalProperties": false,
  "description": "User settings"
}
